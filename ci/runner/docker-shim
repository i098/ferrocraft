#!/bin/sh
# Installed as ~/.local/share/runner-up/shim-ferrocraft/docker (see README.md).
# For a ferrocraft place only: give the job container its own persistent cargo target
# folder, then hand over to the host-wide shim. One folder per place, so two jobs never
# share a target dir. Over-cap folders are deleted before the job starts, so the total at
# job start is at most 4 x PLACE_CAP_GB, plus the growth of the running jobs. The container
# uid differs from the shim uid, so the
# delete needs passwordless sudo.
set -eu
base=${FERROCRAFT_TARGET_ROOT:-/sdc-disk/ci-target}
cap_gb=${FERROCRAFT_PLACE_CAP_GB:-4}
shared=${FERROCRAFT_SHARED_SHIM:-/home/administrator/.local/share/runner-up/shim/docker}
if [ "${1-}" = run ]; then
  place=
  prev=
  for a in "$@"; do
    [ "$prev" = --name ] && place=${a#runner-up-}
    prev=$a
  done
  case $place in
  i098-ferrocraft-[0-9]*)
    d=$base/$place
    mkdir -p "$d"
    used_kb=$(du -sk "$d" | cut -f1)
    if [ "$used_kb" -gt $((cap_gb * 1024 * 1024)) ]; then
      echo "ferrocraft-target: $place used $((used_kb / 1024)) MB, over the ${cap_gb} GB cap; deleting" >&2
      sudo -n find "$d" -mindepth 1 -delete
    fi
    chmod 0777 "$d"
    shift
    set -- run -v "$d:/home/runner/ci-target" -e CARGO_TARGET_DIR=/home/runner/ci-target "$@"
    ;;
  esac
fi
exec "$shared" "$@"
