flowchart TD
    Root["ferrocraft workspace"] --> Cargo["Cargo.toml: members = crates/*, loaders/*, adapters/*"]
    Root --> Crates["crates/"]
    Root --> Loaders["loaders/"]
    Root --> Adapters["adapters/"]
    Root --> Java["java/"]
    Crates --> Engine["engine: game loop, ECS, tick scheduling (core)"]
    Crates --> Protocol["protocol: 1.8.9 protocol 47 codec + packets"]
    Crates --> World["world: chunks, blocks, entities, physics (vanilla ports)"]
    Crates --> Render["render: wgpu renderer, GUI/font/overlay draw targets"]
    Crates --> InputAudio["input-audio: input, audio"]
    Crates --> Launcher["launcher: drop-in install json + boot jar"]
    Crates --> ModApi["modhost-api: stable Rust-to-Java mod host API (versioned)"]
    Crates --> Oracle["oracle: Java oracle harness + differential tests"]
    Loaders --> Forge["forge: Forge 1.8.9 host, LaunchWrapper + Mixin over stand-in classes (Java + Rust glue)"]
    Loaders --> Fabric["fabric: empty slot (README only)"]
    Adapters --> Universal["universal-closed-client: placeholder for future closed-source client adapter (README only)"]
